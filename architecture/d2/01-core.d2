# docs/projects/bitty/architecture/d2/01-core.d2 — L1 subsystem: core crate DAG
# Source of truth: ../glossary.yaml
# Visual rules: rect=module/crate, rounded=panel/capability, dashed=boundary/sandbox, solid=call/depends
# Levels: L1 subsystem — strict DAG per ADR 0003, ADR 0015, and ADR 0016
# To regenerate SVG: d2 01-core.d2 ../final/01-core.svg

direction: down

title: {
  label: "Core Workspace Topology & Extracted Subsystems (ADR-0003 / ADR-0015 / ADR-0016)"
  shape: rectangle
  style.fill: "#f1f5f9"
  style.stroke: "#64748b"
}

# --- Layer: foundation (no workspace deps) ---
foundation: {
  label: "Foundation — no workspace deps"
  style.stroke-dash: 3
  style.fill: "#fefce8"
  vt: {
    label: "bitty-vt\nparser -> TerminalAction"
    shape: rectangle
  }
  pty: {
    label: "bitty-pty\nportable-pty wrapper"
    shape: rectangle
  }
  platform: {
    label: "bitty-platform\nwinit 0.30"
    shape: rectangle
  }
  config: {
    label: "bitty-config\nConfigPlan"
    shape: rectangle
  }
  winjob: {
    label: "bitty-winjob\nWindows Job Object (CTX-0903)"
    shape: rectangle
  }
  package: {
    label: "bitty-package\ntransitioning to plugin-manager (W-72)"
    shape: rectangle
    style.stroke-dash: 2
  }
  lua: {
    label: "bitty-lua\npiccolo 0.3.3"
    shape: rectangle
  }
}

# --- Layer: state ---
state: {
  label: "Terminal Truth"
  style.stroke-dash: 3
  style.fill: "#ecfdf5"
  term_state: {
    label: "bitty-term-state\ngrid / damage / ImageStore"
    shape: rectangle
  }
}

# --- Layer: presentation ---
presentation: {
  label: "Presentation"
  style.stroke-dash: 3
  style.fill: "#eff6ff"
  render: {
    label: "bitty-render\nwgpu 26 (crossfont -> HarfBuzz)"
    shape: rectangle
  }
  ui: {
    label: "bitty-ui\nView / LayoutNode"
    shape: rectangle
  }
  rich: {
    label: "bitty-rich\nplaceholders / DTOs"
    shape: rectangle
  }
}

# --- Layer: host ---
host: {
  label: "Extension Host"
  style.stroke-dash: 3
  style.fill: "#fdf2f8"
  plugin_host: {
    label: "bitty-plugin-host\ncommand / event / capability"
    shape: rectangle
  }
}

# --- Layer: orchestration ---
runtime: {
  label: "bitty-runtime\norchestration & security firewall"
  shape: rectangle
  style.fill: "#ffffff"
  style.stroke-width: 2
}
app: {
  label: "bitty-app\nbinary composition root"
  shape: rectangle
  style.fill: "#ffffff"
  style.stroke-width: 2
}

# --- Independent Extracted Repositories ---
external_repos: {
  label: "Independent Repositories (Extracted from Core)"
  style.stroke-dash: 4
  style.fill: "#f3e8ff"
  ipc_repo: {
    label: "bitty-ipc (repo)\nframing / channels"
    shape: rectangle
  }
  agent_repo: {
    label: "bitty-agent (repo)\nagent protocol vocabulary"
    shape: rectangle
  }
  obs_repo: {
    label: "bitty-observability (repo)\ntracing & audit logging"
    shape: rectangle
  }
  net_repo: {
    label: "bitty-network (repo)\nshared network policy (DIR-017)"
    shape: rectangle
  }
}

# --- Harness (lab & test) ---
harness: {
  label: "Harness & Validation — not product topology"
  style.stroke-dash: 4
  style.fill: "#f8fafc"
  compat_lab: {
    label: "bitty-compat-lab\nvttest harness"
    shape: rectangle
    style.border-radius: 8
  }
  perf: {
    label: "bitty-perf\nbenches"
    shape: rectangle
    style.border-radius: 8
  }
  test_support: {
    label: "bitty-test-support\nshared test helpers"
    shape: rectangle
    style.border-radius: 8
  }
  test_vm: {
    label: "bitty-test-vm\nVM-tier integration harness"
    shape: rectangle
    style.border-radius: 8
  }
}

# --- Edges (solid = depends) ---
state.term_state -> foundation.vt: "depends"
presentation.render -> state.term_state: "snapshot only"
presentation.render -> foundation.platform: "SurfaceTarget"
presentation.render -> foundation.config: "theme presets"
presentation.ui -> state.term_state
presentation.rich -> state.term_state
presentation.rich -> foundation.vt
presentation.rich -> foundation.platform: "clipboard"
presentation.rich -> external_repos.ipc_repo: "fragment DTOs"
host.plugin_host -> state.term_state
host.plugin_host -> foundation.config
host.plugin_host -> foundation.package
runtime -> foundation.vt
runtime -> state.term_state
runtime -> foundation.pty
runtime -> presentation.render
runtime -> foundation.platform
runtime -> presentation.ui
runtime -> host.plugin_host
runtime -> foundation.config
runtime -> foundation.package
runtime -> foundation.lua
runtime -> external_repos.ipc_repo
runtime -> presentation.rich
runtime -> external_repos.obs_repo: "trace hook"

foundation.pty -> foundation.winjob: "Windows Job Object"

app -> runtime
app -> foundation.platform
app -> foundation.config
app -> external_repos.ipc_repo
app -> host.plugin_host
app -> presentation.render
app -> state.term_state

# Harness edges
harness.compat_lab -> foundation.vt {
  style.stroke-dash: 3
}
harness.compat_lab -> state.term_state {
  style.stroke-dash: 3
}
harness.perf -> foundation.vt {
  style.stroke-dash: 3
}
harness.perf -> state.term_state {
  style.stroke-dash: 3
}
harness.perf -> presentation.render {
  style.stroke-dash: 3
}
harness.perf -> foundation.platform {
  style.stroke-dash: 3
}
harness.perf -> runtime {
  style.stroke-dash: 3
}

# Annotation
rules: {
  label: "Rules: Strict DAG, no cycles. Lower layers never depend on higher. Renderer reads snapshot only.\nCore retains Terminal Truth & Capability gate. bitty-core & bitty-panels retired (bitty#1603, bitty#1604).\nbitty-agent, bitty-ipc, bitty-observability, bitty-network extracted to independent repositories."
  shape: rectangle
  style.fill: "#fffbeb"
  style.stroke-dash: 2
}
